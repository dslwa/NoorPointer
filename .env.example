# Template for local runs. Copy to .env (gitignored) and adjust:
#   cp .env.example .env
# docker compose reads .env automatically.

# Must be non-empty and different from each other (see controlplane SecurityConfig).
ADMIN_TOKEN=local-dev-admin
GATEWAY_TOKEN=local-dev-gateway

# Seed demo audit data in the control plane.
DEMO_ENABLED=true

# Gateway JWT (RS256) is required on every route except /healthz.
# Generate a local keypair once, then mint tokens for scripts/benchmarks:
#   make keys     -> gateway/keys/jwt.key + jwt.pub (gitignored)
#   make token    -> prints a fresh JWT
# scripts/smoke.sh, agent-demo/scenarios.sh and the bench targets mint one automatically.
