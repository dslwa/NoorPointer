# Template for local runs. Copy to .env (gitignored) and adjust:
#   cp .env.example .env
# docker compose reads .env automatically.

# Must be non-empty and different from each other (see controlplane SecurityConfig).
ADMIN_TOKEN=local-dev-admin
GATEWAY_TOKEN=local-dev-gateway

# Seed demo audit data in the control plane.
DEMO_ENABLED=true
