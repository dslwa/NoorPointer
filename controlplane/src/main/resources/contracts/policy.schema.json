{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NoorPointer gateway policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "defaults",
    "models",
    "controls"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "semantic_timeout_ms",
        "on_semantic_timeout"
      ],
      "properties": {
        "mode": {
          "enum": [
            "enforce",
            "monitor"
          ]
        },
        "semantic_timeout_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30000
        },
        "on_semantic_timeout": {
          "enum": [
            "fail_open",
            "fail_closed"
          ]
        }
      }
    },
    "models": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed"
      ],
      "properties": {
        "allowed": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        }
      }
    },
    "controls": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "pii_regex": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "action",
            "types"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "action": {
              "enum": [
                "block",
                "redact",
                "monitor"
              ]
            },
            "types": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "email",
                  "pesel",
                  "iban",
                  "card",
                  "phone",
                  "first_name",
                  "last_name",
                  "full_name",
                  "date_of_birth",
                  "postal_code"
                ]
              }
            }
          }
        },
        "secrets": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "action"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "action": {
              "enum": [
                "block",
                "redact",
                "monitor"
              ]
            }
          }
        },
        "prompt_injection": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "action",
            "threshold"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "action": {
              "enum": [
                "block",
                "monitor"
              ]
            },
            "threshold": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "content_safety": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "action",
            "categories"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "action": {
              "enum": [
                "block",
                "monitor"
              ]
            },
            "categories": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^S([1-9]|1[0-4])$"
              }
            }
          }
        },
        "attack_signatures": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "action",
            "refresh_s"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "action": {
              "enum": [
                "block",
                "monitor"
              ]
            },
            "refresh_s": {
              "type": "integer",
              "minimum": 1,
              "maximum": 86400
            }
          }
        },
        "agent_loops": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "action",
            "max_steps",
            "max_identical_tool_calls"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "action": {
              "enum": [
                "block",
                "monitor"
              ]
            },
            "max_steps": {
              "type": "integer",
              "minimum": 1
            },
            "max_identical_tool_calls": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "mcp_tools": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "action",
            "allowed"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "action": {
              "enum": [
                "block",
                "monitor"
              ]
            },
            "allowed": {
              "type": "object",
              "additionalProperties": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                }
              }
            },
            "pinned_hashes": {
              "type": "object",
              "additionalProperties": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        },
        "pii_ner": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "action",
            "directions",
            "threshold",
            "entities"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "action": {
              "enum": [
                "block",
                "redact",
                "monitor"
              ]
            },
            "directions": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "input",
                  "output"
                ]
              }
            },
            "threshold": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "timeout_ms": {
              "type": "integer",
              "minimum": 10,
              "maximum": 30000
            },
            "entities": {
              "type": "array",
              "minItems": 1,
              "maxItems": 100,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9_]{0,79}$"
              }
            }
          }
        },
        "leakage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "action",
            "directions",
            "threshold",
            "ngram"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "action": {
              "enum": [
                "block",
                "monitor"
              ]
            },
            "directions": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "output"
                ]
              }
            },
            "threshold": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "timeout_ms": {
              "type": "integer",
              "minimum": 10,
              "maximum": 30000
            },
            "ngram": {
              "type": "integer",
              "minimum": 2,
              "maximum": 20
            },
            "canaries": {
              "type": "array",
              "maxItems": 100,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
            }
          }
        }
      }
    },
    "budgets": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "subject",
          "on_exceed"
        ],
        "anyOf": [
          {
            "required": [
              "monthly_usd"
            ]
          },
          {
            "required": [
              "daily_tokens"
            ]
          },
          {
            "required": [
              "gpu_seconds_per_hour"
            ]
          }
        ],
        "properties": {
          "subject": {
            "type": "string",
            "pattern": "^(agent|team|model):[^\\s]+$",
            "maxLength": 120
          },
          "monthly_usd": {
            "type": "number",
            "minimum": 0
          },
          "daily_tokens": {
            "type": "integer",
            "minimum": 0
          },
          "gpu_seconds_per_hour": {
            "type": "number",
            "minimum": 0
          },
          "on_exceed": {
            "enum": [
              "block",
              "downgrade_model",
              "alert"
            ]
          }
        }
      }
    }
  }
}
