{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NoorPointer signature feed",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "signatures"
  ],
  "properties": {
    "signatures": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "source",
          "category",
          "action",
          "target",
          "match"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]{1,120}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "source": {
            "type": "string",
            "pattern": "^https://",
            "maxLength": 1000
          },
          "category": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "action": {
            "enum": [
              "block",
              "monitor"
            ]
          },
          "target": {
            "enum": [
              "prompt",
              "tool_name",
              "tool_arguments",
              "model_artifact",
              "upstream_path"
            ]
          },
          "match": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "value"
            ],
            "properties": {
              "type": {
                "const": "literal"
              },
              "value": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              }
            }
          },
          "description": {
            "type": "string",
            "maxLength": 2000
          },
          "enabled": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
